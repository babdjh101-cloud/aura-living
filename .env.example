# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (PLACEHOLDERS ONLY)
# Never commit real credentials, production API keys, or service_role secrets!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLIENT CONFIGURATION (Required for live database, Auth & Storage)
# Obtain from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# Your unique Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Your public "anon" key. Safe to expose in frontend code; RLS enforces all permissions.
# CRITICAL: DO NOT use the "service_role" secret key here!
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ------------------------------------------------------------------------------
# 2. APPLICATION HOSTING
# ------------------------------------------------------------------------------
# In local development: http://localhost:3000
# In Cloudflare Pages: https://your-project.pages.dev (or custom domain)
APP_URL="https://your-domain.com"

# ------------------------------------------------------------------------------
# 3. AI STUDIO RUNTIME SECRETS (Injected automatically in AI Studio environment)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
